# Optional OpenRouter API key. You can also enter it in the local web interface.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional app access protection. Set before exposing the service publicly.
APP_USERNAME=openshorts
APP_PASSWORD=

# Whisper model: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
OUTPUT_DIR=./output
MAX_UPLOAD_SECONDS=14400
MAX_UPLOAD_BYTES=1073741824
